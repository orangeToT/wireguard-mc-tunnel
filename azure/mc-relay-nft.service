[Unit]
Description=Minecraft Bedrock nftables relay rules
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table ip mc_relay
ExecStart=/usr/sbin/nft -f /etc/nftables.d/mc-relay.nft
ExecStop=-/usr/sbin/nft delete table ip mc_relay

[Install]
WantedBy=multi-user.target
