SERVER_NAME=Bedrock Server
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_LIST=true
ONLINE_MODE=true

# Java Edition is opt-in: set JAVA_EULA=TRUE after accepting its EULA,
# then run docker compose --profile java up -d.
JAVA_EULA=FALSE
JAVA_VERSION=LATEST
JAVA_MOTD=Java Server
JAVA_MODE=survival
JAVA_DIFFICULTY=normal
JAVA_MEMORY=1G
# Comma-separated Java profile names (not Bedrock/Xbox gamertags).
JAVA_WHITELIST=
